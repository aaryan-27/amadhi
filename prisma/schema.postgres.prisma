// Amadhi — Prisma schema (PRODUCTION: PostgreSQL 16)
// To use: copy over schema.prisma, set DATABASE_URL to postgres, run migrations,
// then apply prisma/postgres-fts.sql for pg_trgm + tsvector search columns.


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ─── Geography ──────────────────────────────────────────────────────── */

model City {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  state      String
  lat        Float
  lng        Float
  blurb      String     @default("")
  localities Locality[]
  listings   Listing[]
  leads      Lead[]

  @@index([slug])
}

model Locality {
  id           String    @id @default(cuid())
  slug         String
  name         String
  cityId       String
  city         City      @relation(fields: [cityId], references: [id])
  lat          Float
  lng          Float
  overview     String    @default("")
  // JSON string: [{ name, line, distanceKm }]
  metroJson    String    @default("[]")
  listings     Listing[]
  leads        Lead[]

  @@unique([cityId, slug])
  @@index([slug])
}

model Operator {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  logoUrl  String    @default("")
  about    String    @default("")
  website  String    @default("")
  listings Listing[]
}

/* ─── Listings ───────────────────────────────────────────────────────── */

model Listing {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  summary         String           @default("")
  description     String           @default("")
  cityId          String
  city            City             @relation(fields: [cityId], references: [id])
  localityId      String
  locality        Locality         @relation(fields: [localityId], references: [id])
  operatorId      String?
  operator        Operator?        @relation(fields: [operatorId], references: [id])
  address         String
  lat             Float
  lng             Float
  capacity        Int              @default(0)
  openingTime     String           @default("09:00")
  closingTime     String           @default("20:00")
  openDays        String           @default("Mon–Sat")
  status          String           @default("draft") // draft | published | archived
  verified        Boolean          @default(false)
  featured        Boolean          @default(false)
  trending        Boolean          @default(false)
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  virtualTourUrl  String           @default("")
  brochureUrl     String           @default("")
  // JSON string: [{ name, distanceKm, type: "metro"|"landmark" }]
  nearbyJson      String           @default("[]")
  images          ListingImage[]
  amenities       ListingAmenity[]
  plans           Plan[]
  slots           AvailabilitySlot[]
  reviews         Review[]
  leads           Lead[]
  visits          VisitBooking[]
  roomRequests    MeetingRoomRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([cityId, localityId, status])
  @@index([status, featured])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([listingId])
}

model Amenity {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String
  icon     String           @default("Check")
  listings ListingAmenity[]
}

model ListingAmenity {
  listingId String
  amenityId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
}

// Plan: a purchasable product configuration at a listing.
// productType: coworking | managed_office | private_cabin | dedicated_desk |
//              meeting_room | office_leasing | virtual_office
model Plan {
  id          String  @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  productType String
  name        String
  seatsMin    Int     @default(1)
  seatsMax    Int     @default(1)
  prices      Price[]
  highlights  String  @default("") // newline-separated bullets

  @@index([listingId, productType])
  @@index([productType])
}

model Price {
  id       String @id @default(cuid())
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount   Int // INR
  period   String // month | hour | day | sqft_month | year
  unitNote String @default("") // e.g. "per seat", "per cabin"

  @@index([planId])
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime
  slot      String // e.g. "10:00–11:00" or "full-day"
  kind      String   @default("visit") // visit | meeting_room
  isBooked  Boolean  @default(false)

  @@index([listingId, date])
}

/* ─── Demand side (leads, no end-user accounts) ─────────────────────── */

model Company {
  id        String   @id @default(cuid())
  name      String
  size      String   @default("") // 1-10 | 11-50 | 51-200 | 200+
  industry  String   @default("")
  leads     Lead[]
  createdAt DateTime @default(now())
}

// Polymorphic-ish: a lead may reference a city, locality and/or listing.
model Lead {
  id          String    @id @default(cuid())
  type        String // enquiry | visit | meeting_room | brochure | partner | notify_me | contact
  name        String
  phone       String    @default("")
  email       String    @default("")
  message     String    @default("")
  productType String    @default("")
  seats       String    @default("")
  budget      String    @default("")
  moveIn      String    @default("")
  cityId      String?
  city        City?     @relation(fields: [cityId], references: [id])
  localityId  String?
  locality    Locality? @relation(fields: [localityId], references: [id])
  listingId   String?
  listing     Listing?  @relation(fields: [listingId], references: [id])
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  // pipeline: new | contacted | visit_scheduled | negotiation | won | lost
  status      String    @default("new")
  assignedTo  String?
  assignee    AdminUser? @relation(fields: [assignedTo], references: [id])
  notesJson   String    @default("[]") // [{ at, by, text }]
  utmJson     String    @default("{}")
  source      String    @default("website")
  slaDueAt    DateTime?
  firstRespondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model VisitBooking {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  name      String
  phone     String
  email     String   @default("")
  date      DateTime
  slot      String
  status    String   @default("requested") // requested | confirmed | completed | cancelled
  createdAt DateTime @default(now())

  @@index([listingId, date])
}

model MeetingRoomRequest {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  name      String
  phone     String
  email     String   @default("")
  date      DateTime
  startTime String
  hours     Int      @default(1)
  attendees Int      @default(2)
  status    String   @default("requested")
  // Razorpay lands here in Phase 2 — kept nullable by design.
  paymentId String?
  createdAt DateTime @default(now())

  @@index([listingId, date])
}

model Review {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name       String
  email      String   @default("")
  persona    String   @default("") // e.g. "Startup Founder", "Freelancer"
  rating     Int
  title      String   @default("")
  body       String
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())

  @@index([listingId, status])
}

/* ─── Content (blog CMS) ────────────────────────────────────────────── */

model Author {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  role     String     @default("")
  bio      String     @default("")
  avatar   String     @default("")
  linkedin String     @default("")
  posts    BlogPost[]
}

model BlogCategory {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  posts BlogPost[]
}

model Tag {
  id    String        @id @default(cuid())
  slug  String        @unique
  name  String
  posts BlogPostTag[]
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String        @default("")
  // Markdown body (Tiptap edits → markdown storage)
  body        String        @default("")
  coverImage  String        @default("")
  categoryId  String
  category    BlogCategory  @relation(fields: [categoryId], references: [id])
  authorId    String
  author      Author        @relation(fields: [authorId], references: [id])
  tags        BlogPostTag[]
  seoTitle    String        @default("")
  seoDesc     String        @default("")
  status      String        @default("draft") // draft | published | scheduled | archived
  publishedAt DateTime?
  readMins    Int           @default(4)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @default("")
  folder    String   @default("general")
  alt       String   @default("")
  width     Int      @default(0)
  height    Int      @default(0)
  bytes     Int      @default(0)
  createdAt DateTime @default(now())
}

/* ─── Attachable metadata ───────────────────────────────────────────── */

// FAQs attach to any entity: page:{key} | city:{id} | locality:{id} |
// listing:{id} | product:{type}
model Faq {
  id         String @id @default(cuid())
  entityType String
  entityId   String
  question   String
  answer     String
  sortOrder  Int    @default(0)

  @@index([entityType, entityId])
}

model SeoMeta {
  id          String @id @default(cuid())
  entityType  String
  entityId    String
  title       String @default("")
  description String @default("")
  canonical   String @default("")
  ogImage     String @default("")
  noindex     Boolean @default(false)

  @@unique([entityType, entityId])
}

/* ─── Admin (the only authenticated surface) ────────────────────────── */

model Role {
  id          String      @id @default(cuid())
  slug        String      @unique // super_admin | admin | content_writer | seo_executive | sales_manager | sales_executive | viewer
  name        String
  permsJson   String      @default("[]")
  users       AdminUser[]
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  roleId       String
  role         Role          @relation(fields: [roleId], references: [id])
  active       Boolean       @default(true)
  leads        Lead[]
  activities   ActivityLog[]
  createdAt    DateTime      @default(now())
}

model ActivityLog {
  id        String    @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id])
  action    String
  entity    String    @default("")
  entityId  String    @default("")
  metaJson  String    @default("{}")
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  kind      String   @default("info")
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
