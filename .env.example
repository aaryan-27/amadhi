# Amadhi — environment template. Copy to .env and fill in.
# NEVER commit the real .env (it is git-ignored).

# ─── Database (PostgreSQL) ───────────────────────────────────────────
# The app runs on Postgres everywhere. Free options: Vercel Postgres, Neon,
# Supabase. Serverless hosts (Vercel) have a read-only filesystem, so SQLite
# cannot be used there — writes would silently fail.
DATABASE_URL="postgresql://user:password@host:5432/amadhi?sslmode=require"

# Working offline? Use the SQLite variant instead:
#   DATABASE_URL="file:./dev.db"
#   npx prisma generate --schema=prisma/schema.sqlite.prisma

# ─── Admin auth (Auth.js) ────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Password given to the seeded admin users on first `prisma db seed`.
ADMIN_SEED_PASSWORD=""

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Search engine: leave unset for the Prisma "contains" matcher (dev),
# set to "postgres" in production to use pg_trgm similarity ranking.
# SEARCH_ENGINE="postgres"

# ─── Cloudinary (media hosting) ──────────────────────────────────────
# Cloud name is public (it appears in every image URL); the key/secret are not.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
