# Amadhi — environment template. Copy to .env and fill in.
# NEVER commit the real .env (it is git-ignored).

# ─── Database (PostgreSQL) ───────────────────────────────────────────
# The app runs on Postgres everywhere. Free options: Supabase, Neon, Vercel
# Postgres. Serverless hosts (Vercel) have a read-only filesystem, so SQLite
# cannot be used there — writes would silently fail.
#
# DATABASE_URL = runtime queries. On serverless you MUST use the pooled
# connection, or Postgres runs out of connections as functions scale.
# DIRECT_URL   = schema changes (db push / migrate), bypassing the pooler.
# No pooler? Set both to the same value — Prisma errors if DIRECT_URL is unset.
#
# Supabase → Project Settings → Database → Connection string:
#   Transaction pooler (port 6543)  → DATABASE_URL, add the two query params
#   Direct connection  (port 5432)  → DIRECT_URL
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Working offline? Use the SQLite variant instead:
#   DATABASE_URL="file:./dev.db"
#   npx prisma generate --schema=prisma/schema.sqlite.prisma

# ─── Admin auth (Auth.js) ────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Password given to the seeded admin users on first `prisma db seed`.
ADMIN_SEED_PASSWORD=""

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Search engine: leave unset for the Prisma "contains" matcher (dev),
# set to "postgres" in production to use pg_trgm similarity ranking.
# SEARCH_ENGINE="postgres"

# ─── Cloudinary (media hosting) ──────────────────────────────────────
# Cloud name is public (it appears in every image URL); the key/secret are not.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
